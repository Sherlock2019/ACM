# Copy to backend/.env (git-ignored) and edit. Never commit real keys.
# The key stays on the backend; it is never sent to the browser or written to logs or run history.

# LLM tool: "mock" (default, offline) or "claude"
AFM_LLM_PROVIDER=mock

# Claude credentials. Either set an API key here, or leave it empty and run `ant auth login` once.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model and limits (configurable; availability depends on your Anthropic account)
AFM_CLAUDE_MODEL=claude-opus-5-5
AFM_CLAUDE_EFFORT=low
AFM_LLM_TIMEOUT=60

# Ports used by ./start.sh (optional). The UI binds 127.0.0.1 only; from another machine use an SSH tunnel:
#   ssh -L 3010:127.0.0.1:3010 user@server   then open http://127.0.0.1:3010
# AFM_FRONTEND_PORT=3010
# AFM_BACKEND_PORT=8530
# The app lives under this path; the home page is <path>home (default /acm/ → http://host:port/acm/home).
# AFM_BASE_PATH=/acm/
# Public UI (e.g. on EC2: http://<public-ip>:3010/acm/home). WARNING: there is NO LOGIN. Anyone who reaches the
# port can use everything, including real-project mode (clones repositories, runs approved commands on this
# server) and your LLM credits. Default 127.0.0.1 = this machine only. The backend always stays on 127.0.0.1.
# AFM_HOST=0.0.0.0
